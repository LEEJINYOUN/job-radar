# ─────────────────────────────────────────────
# 실제 값은 .env에 넣는다. .env는 커밋되지 않는다.
# ─────────────────────────────────────────────

# 애플리케이션 포트 (doc-nexus 8000/3000과 충돌 방지)
BACKEND_PORT=8001
FRONTEND_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# ── 채용 데이터 소스 ──────────────────────────

# 공공데이터포털 (워크넷/고용24 채용정보, 잡알리오 공공기관 채용정보)
# 발급: https://www.data.go.kr → 마이페이지 → 데이터활용 → Open API → 인증키 발급현황
# 반드시 "일반 인증키(Decoding)"를 넣는다. Encoding 키를 넣으면 이중 인코딩되어
# SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 발생한다.
DATA_GO_KR_SERVICE_KEY=

# 각 API 상세 페이지의 "End Point" 값. 오퍼레이션 경로까지 포함해서 넣는다.
# 예) https://apis.data.go.kr/1051000/recruitment/list
ALIO_API_ENDPOINT=
WORKNET_API_ENDPOINT=

# 고용24 Open-API 직접 발급분 (공공데이터포털 경유보다 제공 데이터가 많음, 선택)
# 발급: https://www.work24.go.kr → 고객센터 → OPEN-API
WORK24_API_KEY=

# 사람인 채용정보 API (승인 필요, 1일 500회 제한)
# 발급: https://oapi.saramin.co.kr
SARAMIN_ACCESS_KEY=
SARAMIN_DAILY_QUOTA=500

# 원티드 OpenAPI (연동 검토 중)
WANTED_API_KEY=

# ── 인프라 ────────────────────────────────────

# PostgreSQL — 공고 저장 및 pg_trgm 유사도 기반 중복 판정
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=job_radar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=job_radar
DATABASE_URL=postgresql://job_radar:change_me@localhost:5432/job_radar

# Meilisearch — 한국어 공고 검색 인덱스
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=change_me_at_least_16_bytes

# Redis — 수집 작업 큐 및 API 잔여 쿼터 카운터
REDIS_URL=redis://localhost:6379

# ── 알림 (Phase 5) ────────────────────────────

# 저장한 검색 조건에 매칭되는 신규 공고 알림
DISCORD_WEBHOOK_URL=
